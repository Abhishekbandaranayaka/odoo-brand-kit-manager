[options]
; Add Odoo core addons path first when running from source, then this repository path.
; Example: addons_path = C:/odoo/odoo/addons,.
addons_path = .

admin_passwd = admin
db_host = localhost
db_port = 5432
db_user = odoo
db_password = odoo

http_port = 8069
logfile = ./odoo.log
data_dir = ./odoo-data
