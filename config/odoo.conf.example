[options]
; Add Odoo core addons path first when running from source, then custom addons path.
; Example: addons_path = C:/odoo/odoo/addons,./custom_addons
addons_path = ./custom_addons

admin_passwd = admin
db_host = localhost
db_port = 5432
db_user = odoo
db_password = odoo

http_port = 8069
logfile = ./odoo.log
data_dir = ./odoo-data

