<odoo>
    <data>
        <template
            id="mail_notification_layout_brand_kit"
            name="Mail: Brand Kit Notification Layout"
            inherit_id="mail.mail_notification_layout"
            primary="True"
        >
            <xpath expr="//t[@t-set='show_footer']" position="after">
                <t
                    t-set="active_brand_kit"
                    t-value="brand_kit or company.brand_kit_id"
                />
                <t
                    t-set="brand_primary_color"
                    t-value="(active_brand_kit and active_brand_kit.primary_color) or company.brand_primary_color or company.email_secondary_color or '#875A7B'"
                />
                <t
                    t-set="brand_secondary_color"
                    t-value="(active_brand_kit and active_brand_kit.secondary_color) or company.brand_secondary_color or '#F4F6FA'"
                />
                <t
                    t-set="brand_footer_text"
                    t-value="(active_brand_kit and active_brand_kit.footer_text) or company.brand_footer_text or ''"
                />
                <t
                    t-set="brand_legal_text"
                    t-value="(active_brand_kit and active_brand_kit.legal_text) or company.brand_legal_text or ''"
                />
                <t
                    t-set="brand_email_header_text"
                    t-value="(active_brand_kit and active_brand_kit.email_header_text) or ((company and company._fields.get('brand_email_header_text')) and company.brand_email_header_text) or ''"
                />
                <t
                    t-set="brand_logo_src"
                    t-value="(active_brand_kit and active_brand_kit.logo and ('/web/image/brand.kit/%s/logo' % active_brand_kit.id)) or ((company and not company.uses_default_logo) and ('/logo.png?company=%s' % company.id)) or ''"
                />
            </xpath>

            <xpath expr="//div[@style='max-width: 900px; width: 100%;']" position="attributes">
                <attribute
                    name="t-att-style"
                >'max-width: 900px; width: 100%; border:1px solid ' + (brand_secondary_color or '#F4F6FA') + '; border-top:4px solid ' + (brand_primary_color or '#875A7B') + '; border-radius:8px; overflow:hidden; background:#FFFFFF;'</attribute>
            </xpath>

            <xpath expr="//td[@t-if='has_button_access' and contains(@t-att-style, 'border-radius')]" position="attributes">
                <attribute
                    name="t-att-style"
                >'border-radius: 3px; text-align: center; background: ' + (brand_primary_color or '#875A7B') + ';'</attribute>
            </xpath>

            <xpath expr="//div[@t-if='show_header and (subtitles or has_button_access or not is_discussion)']" position="before">
                <div
                    t-if="brand_logo_src or brand_email_header_text"
                    style="padding: 12px 16px 6px 16px;"
                >
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width: 100%;">
                        <tbody>
                            <tr>
                                <td t-if="brand_logo_src" valign="middle" style="white-space:nowrap; width:1%;">
                                    <img
                                        t-att-src="brand_logo_src"
                                        t-att-alt="'%s logo' % (company.name or 'Company')"
                                        style="max-height: 52px; max-width: 180px; width: auto; height: auto; display:block;"
                                    />
                                </td>
                                <td
                                    t-if="brand_email_header_text"
                                    valign="middle"
                                    style="font-size: 14px; font-weight: 600; color: #2F3437; padding-left: 12px;"
                                    t-out="brand_email_header_text"
                                />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </xpath>

            <xpath expr="(//div[@t-if='show_footer'])[1]" position="replace">
                <div t-if="show_footer or brand_footer_text or brand_legal_text" style="margin-top:16px;">
                    <hr
                        width="100%"
                        style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 4px 0px;"
                    />
                    <div
                        t-if="brand_footer_text"
                        t-out="brand_footer_text"
                        style="font-size:12px; color:#666666; margin-top:6px; margin-bottom:8px;"
                    />
                    <div
                        t-if="brand_legal_text"
                        t-out="brand_legal_text"
                        style="font-size:11px; color:#888888; margin-bottom:8px;"
                    />
                    <t t-if="not brand_footer_text and not brand_legal_text">
                        <b t-out="company.name" style="font-size:11px;" />
                        <br />
                        <p style="color: #999999; margin-top:2px; font-size:11px;">
                            <t t-out="company.phone" />
                            <t t-if="company.email and company.phone"> |</t>
                            <a
                                t-if="company.email"
                                t-att-href="'mailto:%s' % company.email"
                                style="text-decoration:none; color: #999999;"
                                t-out="company.email"
                            />
                            <t t-if="company.website and (company.phone or company.email)"> |</t>
                            <a
                                t-if="company.website"
                                t-att-href="'%s' % company.website"
                                style="text-decoration:none; color: #999999;"
                                t-out="company.website"
                            />
                        </p>
                    </t>
                </div>
            </xpath>

            <xpath expr="//a[contains(@href, 'odoo.com?utm_source=db&amp;utm_medium=email')]" position="attributes">
                <attribute name="t-att-style">'color: ' + (brand_primary_color or '#875A7B') + ';'</attribute>
            </xpath>
        </template>
    </data>
</odoo>
