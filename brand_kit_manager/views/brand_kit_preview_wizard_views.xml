<odoo>
    <record id="view_brand_kit_preview_wizard_form" model="ir.ui.view">
        <field name="name">brand.kit.preview.wizard.form</field>
        <field name="model">brand.kit.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Brand Kit Preview" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="brand_kit_id" />
                    </group>
                    <label string="Preview how selected templates will look before applying changes." />
                    <field name="line_ids" nolabel="1">
                        <tree create="0" delete="0">
                            <field name="template_id" />
                            <field name="model_name" />
                            <field name="subject" />
                        </tree>
                        <form string="Template Preview" create="0" edit="0">
                            <group>
                                <field name="template_id" />
                                <field name="model_name" />
                                <field name="subject" />
                            </group>
                            <notebook>
                                <page string="Current">
                                    <field name="current_body_html" widget="html" />
                                </page>
                                <page string="Preview">
                                    <field name="preview_body_html" widget="html" />
                                </page>
                            </notebook>
                        </form>
                    </field>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
