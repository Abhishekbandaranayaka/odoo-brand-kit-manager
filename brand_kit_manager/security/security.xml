<odoo>
    <record id="brand_kit_rule_multi_company" model="ir.rule">
        <field name="name">Brand Kit Multi Company</field>
        <field name="model_id" ref="model_brand_kit" />
        <field name="global" eval="False" />
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
